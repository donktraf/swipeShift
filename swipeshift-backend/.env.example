# Kopie nach .env. Alle Werte sind Platzhalter — nie echte Secrets einchecken.

# Runtime: development | test | production.
# Ausserhalb von development/test bricht der Start ohne TOTP_ENCRYPTION_KEY und BACKUP_CODE_PEPPER ab.
# Lokal `npm run dev` setzt NODE_ENV=development selbst (Skripte setzen Variablen per Shell-Syntax → macOS/Linux).
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://swipeshift:swipeshift_pw@localhost:5432/swipeshift_dev

# JWT
JWT_SECRET=change_me_to_a_long_random_string

# 2FA / Authenticator-App (TOTP)
# Schuetzt TOTP-Secrets UND gespeicherte Bank-Kontonummern (Auszahlung). Variablenname bleibt aus Kompatibilitaet.
# 32 Byte: `openssl rand -hex 32`. In Nicht-Dev Pflicht (nur 64 hex oder base64 mit 32 Byte).
TOTP_ENCRYPTION_KEY=
# Nur waehrend einer Key-Rotation: alter Key (gilt fuer TOTP-Secrets und Bankdaten). Danach `node scripts/rotate-totp-key.js` und PREVIOUS entfernen.
TOTP_ENCRYPTION_KEY_PREVIOUS=
# Stabiler Pepper fuer Backup-Codes (NICHT rotieren, sonst werden bestehende Backup-Codes ungueltig).
# `openssl rand -hex 32`. In Nicht-Dev Pflicht.
BACKUP_CODE_PEPPER=

# Hinter einem Reverse-Proxy: Anzahl Hops (z.B. 1) oder Liste von Proxy-IPs/CIDRs (z.B. 10.0.0.0/8,172.16.0.5).
# "true" ist nicht erlaubt. Leer lassen, wenn kein Proxy davor steht.
TRUST_PROXY=

# Social Login
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Mail (lokal MailHog: smtp 1025, UI http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=SwipeShift <no-reply@swipeshift.local>
SUPPORT_EMAIL=support@swipeshift.app

# Links
APP_SCHEME=swipeshift
PUBLIC_API_BASE_URL=http://localhost:3000
PUBLIC_RESET_FALLBACK_URL=


# Push-Benachrichtigungen (APNs). Ohne diese Variablen bleibt Push inaktiv (Log: "push skipped: APNs not configured").
# Voraussetzung: bezahlter Apple-Developer-Account + Push-Notifications-Capability in der App.
# Auth-Key (.p8) im Apple-Developer-Portal unter Keys erzeugen; nie einchecken.
APNS_KEY_ID=
APNS_TEAM_ID=
# Bundle-ID der App (= apns-topic); aktuell com.swipeShift
APNS_BUNDLE_ID=
# Inhalt der .p8-Datei (Zeilenumbrueche als \n) ODER Pfad zur Datei:
APNS_KEY=
APNS_KEY_PATH=
