// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  worker
  employer
}

enum OnboardingStatus {
  pendingRole
  pendingProfile
  complete
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole?
  onboarding   OnboardingStatus @default(pendingRole)

  firstName String?
  lastName  String?

  location  String?
  lat Float?
  lng Float?
  createdAt DateTime @default(now())

  emailVerifiedAt DateTime?

  // Presence fuer Chat: zuletzt aktiv (gedrosselt aktualisiert in requireAuth)
  lastSeenAt DateTime?

  worker   Worker?
  employer Employer?

  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  applies Apply[]
  savedCompanies SavedCompany[]
}

model Worker {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dateOfBirth     DateTime
  bio             String?  @db.Text
  profilePhotoUrl String?

  jobInterests Json
  availability Json

  phone               String?
  willingToRelocate   Boolean  @default(false)
  maxTravelDistance   Int      @default(10)
  transport           String   @default("car")
  availableForSameDay Boolean  @default(false)
  preferredCategories String[]
  payRangeMin         Float?
  payRangeMax         Float?
  skills              Json?
  workAuthorization   Boolean  @default(false)

  createdAt DateTime @default(now())
}

model Employer {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String
  companySize String
  industry    String

  companyLogoUrl     String?
  websiteOrInstagram String?
  companyDescription String? @db.Text

  companyPhone            String?
  companyEmail            String?
  businessAreas           String[]
  locations               String[]
  primaryHiringLocation   String?
  teamMembers             Json?
  jobTitle                String?
  managerRole             String?
}

model PasswordResetToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ─── Jobs ────────────────────────────────────────────────────────────────────

model Job {
  id          String    @id @default(uuid())
  title       String
  company     String
  location    String
  lat         Float?
  lng         Float?

  payAmount   Float?
  payText     String
  startTime   DateTime?
  endTime     DateTime?
  shiftText   String    @default("")
  duration    String?
  shortInfo   String    @default("") @db.Text

  // Detail fields (JobDetailView)
  jobDescription  String?  @db.Text
  tasks           String[]
  openSpots       Int      @default(1)
  dressCode       String?
  languages       String[]
  experienceLevel String?
  minAge          Int?
  paymentMethod   String?
  contractType    String?
  companyRating   Float?
  replyTime       String?
  // Optionaler Grund, den der Employer beim Stornieren angibt (Worker-Kalender / Job Applications)
  cancellationReason String?
  isVerified      Boolean  @default(false)

  // Categorisation
  tags      String[]
  logoEmoji String   @default("🏢")
  category  String?

  // Schichten als JSON (Array von {id,date,timeRange,duration,totalPay})
  shifts    Json     @default("[]")

  status    String   @default("published")
  employerId String?

  createdAt DateTime @default(now())

  applies       Apply[]
  skips         Skip[]
  saves         Save[]
  conversations Conversation[]
}

model Apply {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  status    String   @default("pending") // pending, accepted, declined
  isPaid    Boolean  @default(false)
  createdAt DateTime @default(now())
  // Erste Antwort des Employers (accept/decline) → Response Rate + Response Time im Company-Profil
  respondedAt DateTime?

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  job            Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  conversation   Conversation?
  review         Review?
  savedApplicant SavedApplicant?
  workerReview   WorkerReview?

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

model Review {
  id           String   @id @default(uuid())
  employerId   String
  workerId     String
  jobId        String
  applyId      String   @unique

  communication Int
  teamwork      Int
  reliability   Int
  underPressure Int
  comment       String?  @db.Text
  wouldRehire   Boolean  @default(true)

  createdAt DateTime @default(now())

  apply Apply @relation(fields: [applyId], references: [id], onDelete: Cascade)

  @@index([employerId])
  @@index([workerId])
  @@index([jobId])
}

model WorkerReview {
  id                     String   @id @default(uuid())
  applyId                String   @unique
  employerId             String
  workerId               String
  jobId                  String
  communication          Int
  paymentFairness        Int
  workEnvironment        Int
  jobDescriptionAccuracy Int
  overallExperience      Int
  comment                String?  @db.Text
  createdAt              DateTime @default(now())

  apply Apply @relation(fields: [applyId], references: [id], onDelete: Cascade)

  @@index([employerId])
  @@index([workerId])
  @@index([jobId])
}

model Conversation {
  id         String   @id @default(uuid())
  applyId    String   @unique
  jobId      String
  workerId   String
  employerId String?
  status     String   @default("active") // active, completed, cancelled

  // Pro-Teilnehmer Lesebestaetigung + Typing-Indicator (Polling-basiert)
  workerLastReadAt   DateTime?
  employerLastReadAt DateTime?
  workerTypingAt     DateTime?
  employerTypingAt   DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  apply    Apply     @relation(fields: [applyId], references: [id], onDelete: Cascade)
  job      Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([workerId])
  @@index([employerId])
  @@index([jobId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  text           String   @db.Text
  isSystem       Boolean  @default(false)
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

model Skip {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

model Save {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

// Worker bookmarks a company for later reference
model SavedCompany {
  id          String   @id @default(uuid())
  userId      String
  companyName String
  savedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyName])
  @@index([userId])
}

// Employer bookmarks a worker (Apply) for later review
model SavedApplicant {
  id         String   @id @default(uuid())
  employerId String
  applyId    String   @unique
  createdAt  DateTime @default(now())

  apply Apply @relation(fields: [applyId], references: [id], onDelete: Cascade)

  @@unique([employerId, applyId])
  @@index([employerId])
}
