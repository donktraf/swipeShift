// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  worker
  employer
}

enum OnboardingStatus {
  pendingRole
  pendingProfile
  complete
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole?
  onboarding   OnboardingStatus @default(pendingRole)

  firstName String?
  lastName  String?

  location  String?
  lat Float?
  lng Float?
  createdAt DateTime @default(now())

  emailVerifiedAt DateTime?

  worker   Worker?
  employer Employer?

  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  applies Apply[]
}

model Worker {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dateOfBirth     DateTime
  bio             String?  @db.Text
  profilePhotoUrl String?

  jobInterests Json
  availability Json

  createdAt DateTime @default(now())
}

model Employer {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String
  companySize String
  industry    String

  companyLogoUrl     String?
  websiteOrInstagram String?
  companyDescription String? @db.Text
}

model PasswordResetToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ─── Jobs ────────────────────────────────────────────────────────────────────

model Job {
  id          String    @id @default(uuid())
  title       String
  company     String
  location    String
  lat         Float?
  lng         Float?

  payAmount   Float?
  payText     String
  startTime   DateTime?
  endTime     DateTime?
  shiftText   String    @default("")
  duration    String?
  shortInfo   String    @default("") @db.Text

  // Detail fields (JobDetailView)
  jobDescription  String?  @db.Text
  tasks           String[]
  openSpots       Int      @default(1)
  dressCode       String?
  languages       String[]
  experienceLevel String?
  minAge          Int?
  paymentMethod   String?
  contractType    String?
  companyRating   Float?
  replyTime       String?
  isVerified      Boolean  @default(false)

  // Categorisation
  tags      String[]
  logoEmoji String   @default("🏢")
  category  String?

  // Schichten als JSON (Array von {id,date,timeRange,duration,totalPay})
  shifts    Json     @default("[]")

  status    String   @default("published")
  employerId String?

  createdAt DateTime @default(now())

  applies       Apply[]
  skips         Skip[]
  saves         Save[]
  conversations Conversation[]
}

model Apply {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  status    String   @default("pending") // pending, accepted, declined
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  conversation Conversation?

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

model Conversation {
  id         String   @id @default(uuid())
  applyId    String   @unique
  jobId      String
  workerId   String
  employerId String?
  status     String   @default("active") // active, completed, cancelled
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  apply    Apply     @relation(fields: [applyId], references: [id], onDelete: Cascade)
  job      Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([workerId])
  @@index([employerId])
  @@index([jobId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  text           String   @db.Text
  isSystem       Boolean  @default(false)
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

model Skip {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

model Save {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}
