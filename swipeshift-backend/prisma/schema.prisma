// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  worker
  employer
}

enum OnboardingStatus {
  pendingRole
  pendingProfile
  complete
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // Kanonische Form fuer Ban-Evasion-Check (Gmail-Punkte, +tag; siehe src/utils/emailCanonical.js). NICHT unique.
  emailCanonical String?
  passwordHash String
  role         UserRole?
  onboarding   OnboardingStatus @default(pendingRole)

  firstName String?
  lastName  String?

  location  String?
  lat Float?
  lng Float?
  createdAt DateTime @default(now())

  emailVerifiedAt DateTime?

  // Apple-Subject (stabile Apple-ID) → Apple-Login matcht darueber statt ueber unverifizierte E-Mail
  appleSub String? @unique

  // Presence fuer Chat: zuletzt aktiv (gedrosselt aktualisiert in requireAuth)
  lastSeenAt DateTime?

  // Glocke zuletzt geoeffnet (Benachrichtigungen sind dynamisch → Ungelesen = Zeitstempel > notificationsSeenAt)
  notificationsSeenAt DateTime?

  // 2FA per E-Mail-Code (beim Login wird zusaetzlich ein Code an die E-Mail geschickt)
  twoFactorEnabled Boolean @default(false)
  // "email" | "totp" (null + twoFactorEnabled = Altbestand = email)
  twoFactorMethod  String?
  // TOTP-Secret (AES-256-GCM, siehe src/utils/totp.js); Pending = Einrichtung noch nicht bestaetigt
  totpSecretEnc    String?
  totpPendingEnc   String?
  // Zuletzt akzeptierter 30-s-Zeitschritt → ein Code ist nur einmal nutzbar
  totpLastStep     Int?
  totpPendingAt    DateTime?
  twoFactorLocks   TwoFactorLock[]
  backupCodes      TwoFactorBackupCode[]

  // Konto-Einstellungen (Benachrichtigungen, Ruhezeiten, Auszahlung) — Form siehe src/utils/settings.js
  settings Json?
  // Konto pausiert: Worker kann sich nicht bewerben, Jobs eines Employers sind ausgeblendet
  pausedAt DateTime?
  // Moderation: Admin-Konto (nur per CLI-Skript `npm run make-admin` gesetzt, nie per API)
  isAdmin Boolean @default(false)
  // Gesperrt bis (Zukunft = gesperrt; "pending_review" = Auto-Sperre ohne festes Ende, Zeitpunkt weit in der Zukunft)
  suspendedUntil   DateTime?
  // Dauerhaft gebannt
  bannedAt         DateTime?
  // "pending_review" | "admin" (siehe src/utils/moderation.js)
  suspensionReason String?
  // IANA-Zeitzone des Geraets (Header X-Time-Zone) → Ruhezeiten fuer Push, siehe src/utils/notifyPolicy.js
  timeZone String?

  // Rechtliche Zustimmungen: Map Consent-Key -> ISO-Zeitstempel (Widerruf = Key entfernt), siehe src/utils/consents.js
  legalConsents Json?

  worker   Worker?
  employer Employer?

  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  applies Apply[]
  savedCompanies SavedCompany[]
  sessions UserSession[]
  pushDevices PushDevice[]
  twoFactorCodes TwoFactorCode[]
  blocksGiven    UserBlock[]  @relation("BlocksGiven")
  blocksReceived UserBlock[]  @relation("BlocksReceived")

  @@index([emailCanonical])
}

// Eine Login-Sitzung pro Geraet. Jeder JWT traegt die Session-ID (sid);
// requireAuth lehnt Tokens ab, deren Session widerrufen oder abgelaufen ist.
model UserSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  city        String?   // grober Ort vom Geraet ("Austin, TX"), siehe X-Device-City
  deviceName  String?   // z.B. "iPhone", "iPad"
  deviceModel String?   // Hardware-Kennung, z.B. "iPhone16,1"
  osVersion   String?   // z.B. "iOS 18.1"
  ipAddress   String?

  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  reauthAt     DateTime? // letzter Step-up (Re-Auth) dieser Sitzung, gueltig 10 min (utils/reauth.js)

  @@index([userId])
}

// APNs-Geraetetoken pro Login-Sitzung (Push-Benachrichtigungen). Wird mit der Session geloescht.
model PushDevice {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique
  environment String   // "sandbox" | "production"
  sessionId   String?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
}

enum TwoFactorPurpose {
  login
  enable
  disable
  totp_enable // Mail-Code als Re-Auth vor der TOTP-Einrichtung
  reauth      // Mail-Code als Step-up vor dem Aendern von Auszahlungsdaten
  switch_email // Mail-Code beim Wechsel Authenticator -> E-Mail (an Sitzung gebunden)
}

// Einmal-Code (6-stellig, gehasht) fuer Login-Challenge bzw. 2FA an-/ausschalten.
model TwoFactorCode {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose    TwoFactorPurpose
  sessionId  String?   // nur switch_email: Sitzung, die den Wechsel gestartet hat
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose])
}

// Sperre gegen Code-Raten pro User+IP (Entscheidungslogik: nextLockState in utils/twoFactor.js)
model TwoFactorLock {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip            String
  failedCount   Int       @default(0)
  firstFailedAt DateTime
  lockedUntil   DateTime?
  notifiedAt    DateTime?

  @@unique([userId, ip])
}

// Einmal-Backup-Code fuer TOTP-2FA (nur HMAC-Hash gespeichert).
model TwoFactorBackupCode {
  id       String    @id @default(uuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt   DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Worker {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dateOfBirth     DateTime
  bio             String?  @db.Text
  profilePhotoUrl String?

  jobInterests Json
  availability Json

  phone               String?
  willingToRelocate   Boolean  @default(false)
  maxTravelDistance   Int      @default(10)
  transport           String   @default("car")
  availableForSameDay Boolean  @default(false)
  preferredCategories String[]
  payRangeMin         Float?
  payRangeMax         Float?
  skills              Json?
  workAuthorization   Boolean  @default(false)

  // Tageszeiten (morning/afternoon/evening/night), Schicht-Typen (oneDay/weekend/eventBased),
  // Vorerfahrung [{category, level: lt3m|m3to12|gt1y}] - Whitelists in src/utils/profileFields.js
  availableTimes String[] @default([])
  shiftTypes     String[] @default([])
  experience     Json?

  createdAt DateTime @default(now())
}

model Employer {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String
  companySize String
  industry    String

  companyLogoUrl     String?
  websiteOrInstagram String?
  companyDescription String? @db.Text

  companyPhone            String?
  companyEmail            String?
  businessAreas           String[]
  locations               String[]
  primaryHiringLocation   String?
  teamMembers             Json?
  jobTitle                String?
  managerRole             String?

  // Oeffentliches Firmenprofil (Worker-Sicht)
  yearFounded            Int?
  tagline                String?
  socialLinks            Json?
  streetAddress          String?
  zipCode                String?
  addressLat             Float?
  addressLng             Float?
  publicContactName      String?
  publicContactRole      String?
  postsInMultipleStates  Boolean @default(false)
  remoteFriendly         Boolean @default(false)
}

model PasswordResetToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ─── Jobs ────────────────────────────────────────────────────────────────────

model Job {
  id          String    @id @default(uuid())
  title       String
  company     String
  location    String
  lat         Float?
  lng         Float?

  payAmount   Float?
  payText     String
  startTime   DateTime?
  endTime     DateTime?
  shiftText   String    @default("")
  duration    String?
  shortInfo   String    @default("") @db.Text

  // Detail fields (JobDetailView)
  jobDescription  String?  @db.Text
  tasks           String[]
  openSpots       Int      @default(1)
  dressCode       String?
  languages       String[]
  experienceLevel String?
  minAge          Int?
  paymentMethod   String?
  contractType    String?
  companyRating   Float?
  replyTime       String?
  // Optionaler Grund, den der Employer beim Stornieren angibt (Worker-Kalender / Job Applications)
  cancellationReason String?
  isVerified      Boolean  @default(false)

  // Optionale Zusatzfelder (Add Job): Anforderungen, Konditionen, Hinweise
  requiredSkills        String[]
  physicalRequirements  String[]
  certifications        String[]
  educationLevel        String?
  workAuthorizationRequired Boolean @default(false)
  urgency               String   @default("normal")  // normal | urgent
  locationType          String   @default("single")  // single | multiple
  breakIncluded         Boolean  @default(false)
  breakMinutes          Int?                         // 15/30/45/60, nur bei breakIncluded
  sameDayPay            Boolean  @default(false)
  tipsIncluded          Boolean  @default(false)
  repeatWork            Boolean  @default(false)
  bonusAvailable        Boolean  @default(false)
  bonusDescription      String?
  cancellationPolicy    String?                      // flexible | 24h | 48h | strict
  cancellationNotes     String?
  jobNotes              String?  @db.Text
  instantMatch          Boolean  @default(false)
  termsAcceptedAt       DateTime?
  // Plattform-Gebuehr in Prozent, beim Veroeffentlichen eingefroren (null = Entwurf/Altjob → aktueller Default, utils/fees.js)
  platformFeePercent    Float?
  // Zeitpunkt, zu dem der Employer die Bewerberliste dieses Jobs zuletzt geoeffnet hat ("New Matches")
  applicantsSeenAt      DateTime?
  // "Payment open"-Hinweis an den Employer (Job vorbei, unbezahlte Worker) bereits verschickt
  paymentReminderSentAt DateTime?
  // Erinnerung an den Employer, Anwesenheit zu erfassen (~24 h nach Schichtende) bereits verschickt
  attendanceReminderSentAt DateTime?

  // Categorisation
  tags      String[]
  logoEmoji String   @default("🏢")
  category  String?

  // Schichten als JSON (Array von {id,date,timeRange,duration,totalPay})
  shifts    Json     @default("[]")

  status    String   @default("published")
  employerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  applies       Apply[]
  skips         Skip[]
  saves         Save[]
  conversations Conversation[]
}

model Apply {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  status    String   @default("pending") // pending, accepted, declined, cancelled_by_worker
  isPaid    Boolean  @default(false)
  // true = durch Instant Match automatisch angenommen (kein respondedAt, zaehlt nicht in Response-Stats)
  autoAccepted Boolean @default(false)
  createdAt DateTime @default(now())
  // Erste Antwort des Employers (accept/decline) → Response Rate + Response Time im Company-Profil
  respondedAt DateTime?
  // Zeitpunkt JEDES Uebergangs zu accepted (auch Re-Accept nach Decline, Instant Match) → Benachrichtigungen/Badge
  acceptedAt DateTime?
  // Zeitpunkt der Zahlung (isPaid = true) → Benachrichtigung "Payment received"
  paidAt DateTime?
  // Schicht-Erinnerung (Push/Mail, ~24h vorher) bereits verschickt → genau einmal (bedingtes updateMany als Claim)
  reminderSentAt DateTime?

  // Worker storniert eine ANGENOMMENE Schicht (status = cancelled_by_worker); lateCancellation = weniger als 24 h vor Start
  cancelledAt      DateTime?
  lateCancellation Boolean   @default(false)
  cancelReason     String?

  // Gebuchte Schichten (Job.shifts[].id). Leer = Altbestand → alle Schichten des Jobs (siehe utils/shiftBooking.js)
  shiftIds         String[]  @default([])

  // Anwesenheit (vom Employer nach Schichtende erfasst, sonst nach 48 h automatisch "attended")
  attendance        String?   // attended | late | no_show | null (noch offen)
  attendanceSetAt   DateTime?
  attendanceSource  String?   // employer | auto | admin
  // Einmaliger Einspruch des Workers + Entscheidung eines Admins (upheld | changed)
  disputeNote       String?
  disputedAt        DateTime?
  disputeResolvedAt DateTime?
  disputeResolution String?
  // No-Show-Erinnerung an den Worker bereits verschickt → hoechstens einmal pro Bewerbung (bedingtes updateMany als Claim)
  noShowNotifiedAt  DateTime?

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  job            Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  conversation   Conversation?
  review         Review?
  savedApplicant SavedApplicant?
  workerReview   WorkerReview?
  reviewDraft    ReviewDraft?

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

model Review {
  id           String   @id @default(uuid())
  employerId   String
  workerId     String
  jobId        String
  applyId      String   @unique

  communication Int
  teamwork      Int
  reliability   Int
  underPressure Int
  // Nullable: Bestandsbewertungen haben diese Kategorie nicht
  workQuality   Int?
  comment       String?  @db.Text
  wouldRehire   Boolean  @default(true)
  topWorker     Boolean  @default(false)

  createdAt DateTime @default(now())

  apply Apply @relation(fields: [applyId], references: [id], onDelete: Cascade)

  @@index([employerId])
  @@index([workerId])
  @@index([jobId])
}

// Gespeicherter Entwurf einer Arbeitgeber→Worker-Bewertung
model ReviewDraft {
  id         String   @id @default(uuid())
  applyId    String   @unique
  employerId String
  data       Json
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  apply Apply @relation(fields: [applyId], references: [id], onDelete: Cascade)

  @@index([employerId])
}

model WorkerReview {
  id                     String   @id @default(uuid())
  applyId                String   @unique
  employerId             String
  workerId               String
  jobId                  String
  communication          Int
  paymentFairness        Int
  workEnvironment        Int
  jobDescriptionAccuracy Int
  overallExperience      Int
  // Nullable: Bestandsbewertungen kennen diese Frage nicht
  wouldWorkAgain         Boolean?
  comment                String?  @db.Text
  createdAt              DateTime @default(now())

  apply Apply @relation(fields: [applyId], references: [id], onDelete: Cascade)

  @@index([employerId])
  @@index([workerId])
  @@index([jobId])
}

model Conversation {
  id         String   @id @default(uuid())
  applyId    String   @unique
  jobId      String
  workerId   String
  employerId String?
  status     String   @default("active") // active, completed, cancelled

  // Pro-Teilnehmer Lesebestaetigung + Typing-Indicator (Polling-basiert)
  workerLastReadAt   DateTime?
  employerLastReadAt DateTime?
  workerTypingAt     DateTime?
  employerTypingAt   DateTime?

  // Zeitpunkt der letzten Ungelesen-Mail pro Empfaenger (max. 1 Mail pro Konversation und Stunde)
  workerEmailNotifiedAt   DateTime?
  employerEmailNotifiedAt DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  apply    Apply     @relation(fields: [applyId], references: [id], onDelete: Cascade)
  job      Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([workerId])
  @@index([employerId])
  @@index([jobId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  text           String   @db.Text
  isSystem       Boolean  @default(false)
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

model Skip {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  // true = "Not interested" (aus Gespeichert) → Job wird in ALLEN Feeds ausgeblendet, nicht nur im Swipe-Feed
  notInterested Boolean @default(false)
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

model Save {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

// Worker bookmarks a company for later reference
model SavedCompany {
  id          String   @id @default(uuid())
  userId      String
  companyName String
  savedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyName])
  @@index([userId])
}

// Employer bookmarks a worker (Apply) for later review
model SavedApplicant {
  id         String   @id @default(uuid())
  employerId String
  applyId    String   @unique
  createdAt  DateTime @default(now())

  apply Apply @relation(fields: [applyId], references: [id], onDelete: Cascade)

  @@unique([employerId, applyId])
  @@index([employerId])
}

// Nutzer A blockiert Nutzer B (Chat in beide Richtungen gesperrt, Inhalte bleiben lesbar)
model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Bewusst OHNE Foreign Keys: Reports ueberleben die Loeschung der Konten (Moderation/Nachweis).
// Meldung eines Nutzers (Whitelist der Gruende: src/utils/safety.js); wird per Mail an Support gesendet
model UserReport {
  id             String   @id @default(uuid())
  reporterId     String
  reportedUserId String
  conversationId String?
  reason         String
  details        String?  @db.Text
  status         String   @default("open")
  createdAt      DateTime @default(now())
  // Moderation: "action_taken" | "dismissed"
  resolvedAt     DateTime?
  resolvedById   String?
  resolution     String?

  @@index([reporterId, reportedUserId, conversationId])
  @@index([status])
  @@index([reportedUserId, status])
}

// Tombstone eines geloeschten Kontos, NUR wenn Meldungen/Moderation vorlagen (Datensparsamkeit, Missbrauchsschutz:
// sonst koennte man durch Loeschen + Neuregistrierung einer Sperre entgehen). Keine Klartext-Mail: nur ein
// gepefferter HMAC (EMAIL_BAN_PEPPER) der kanonischen Adresse (src/emailBan.js). displayName nur fuer die Admin-Anzeige.
// TODO: in der Privacy Policy erwaehnen (Aufbewahrung zum Schutz vor Missbrauch).
model DeletedAccount {
  id                 String    @id // = alte User-ID (Reports/ModerationAction referenzieren sie weiter)
  emailCanonicalHash String
  hashVersion        Int       @default(1) // Pepper-Generation; noch nicht ausgewertet (Pruefung gegen EMAIL_BAN_PEPPER + _PREV), Platzhalter fuer spaeteres Neu-Hashen
  appleSubHash       String?   // HMAC der Apple-Subject-ID (kein Google-Sub im User-Modell gespeichert)
  emailVerified      Boolean   @default(false)
  role               String?
  displayName        String?
  deletedAt          DateTime  @default(now())
  bannedAt           DateTime?
  suspendedUntil     DateTime? // nur feste Admin-Sperre (keine Auto-Sperre "pending_review")
  unbannedAt         DateTime? // Admin hat die E-Mail entbannt → Retention (90 Tage) rechnet ab hier

  @@index([emailCanonicalHash, bannedAt])
  @@index([appleSubHash])
}

// Protokoll aller Moderationsentscheidungen (adminId null = System, z.B. Auto-Sperre)
model ModerationAction {
  id           String   @id @default(uuid())
  reportId     String?
  targetUserId String
  adminId      String?
  // "warn" | "suspend" | "ban" | "dismiss" | "auto_suspend" | "lift"
  action       String
  durationDays Int?
  note         String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([reportId])
}
